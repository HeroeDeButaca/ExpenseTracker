<UserControl x:Class="ExpenseTracker.View.UserControls.RoundedSquareInfo"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExpenseTracker.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="160" d:DesignWidth="320">
    <Grid>
        <Border Background="{Binding Background, ElementName=root}" CornerRadius="20"/>
        <Viewbox Stretch="Uniform" Margin="12" StretchDirection="DownOnly">
            <Grid Width="296" Height="136">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>

                <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding TitleText, ElementName=root}" FontSize="40" 
                               Foreground="{Binding TitleColor, ElementName=root}" FontWeight="Bold" TextWrapping="Wrap"/>
                </Viewbox>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding MoneyText, ElementName=root}" FontSize="32"
                           Foreground="{Binding MoneyTextColor, ElementName=root}" TextWrapping="Wrap"/>
            </Grid>
        </Viewbox>
        
    </Grid>
</UserControl>
